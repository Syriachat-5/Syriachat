rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function me(){ return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isAdmin(){ return signedIn() && exists(me()) && get(me()).data.admin == true; }
    function ok(){ return signedIn() && (!exists(me()) || (get(me()).data.banned != true && !(get(me()).data.get('status','ok') in ['pending','rejected']))); }
    function chatMembers(c){ return get(/databases/$(database)/documents/chats/$(c)).data.members; }

    // صلاحيات المجموعات: تعديل (owner, admins, closed, deny, name, photo, cdate) للمنشئ/المشرف فقط،
    // والعضو العادي يستطيع مغادرة المجموعة فقط (إزالة نفسه من members)
    function groupOk(){
      let r = resource.data; let n = request.resource.data;
      let ch = n.diff(r).affectedKeys();
      return r.get('type','private') != 'group'
        || request.auth.uid == r.get('owner', r.members[0])
        || request.auth.uid in r.get('admins', [])
        || (!ch.hasAny(['owner','admins','closed','deny','name','photo','cdate'])
            && (!ch.hasAny(['members'])
                || (!(request.auth.uid in n.members) && n.members.size() == r.members.size() - 1)));
    }

    // آخر ظهور / متصل الآن
    match /presence/{id} {
      allow read: if ok();
      allow write: if ok() && request.auth.uid == id;
    }

    match /cfg/{d} { allow read: if true; allow write: if isAdmin(); }

    match /users/{id} {
      allow read: if ok() || (signedIn() && request.auth.uid == id);
      allow create: if signedIn() && request.auth.uid == id
        && request.resource.data.status == 'pending' && request.resource.data.setup == false
        && request.resource.data.bal == 100 && request.resource.data.verified == false
        && request.resource.data.admin == false && request.resource.data.banned == false
        && request.resource.data.vreq == false;
      allow update: if isAdmin()
        || (ok() && request.auth.uid == id
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','bio','vreq','contacts','setup']))
        || (ok() && request.auth.uid == id && !('code' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code']))
        || (ok() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bal'])
            && (request.auth.uid == id ? request.resource.data.bal < resource.data.bal
                                       : request.resource.data.bal > resource.data.bal));
      allow delete: if isAdmin();
    }

    // عدد الحسابات لكل جهاز (يتحكم به الأدمن من لوحة الإدارة)
    match /devs/{id} {
      allow read: if true;
      allow create: if isAdmin() || (signedIn() && request.resource.data.n == 1 && request.resource.data.extra == 0);
      allow update: if isAdmin() || (signedIn() && request.resource.data.n == resource.data.n + 1
        && request.resource.data.extra == resource.data.extra);
      allow delete: if isAdmin();
    }

    match /chats/{id} {
      allow read: if isAdmin() || (ok() && request.auth.uid in resource.data.members);
      allow create: if ok() && request.auth.uid in request.resource.data.members;
      allow update: if isAdmin() || (ok() && request.auth.uid in resource.data.members && groupOk());
      allow delete: if isAdmin();
    }

    // صور ورسائل صوتية (مخزنة كنص base64 داخل Firestore)
    match /media/{id} {
      allow create: if ok() && request.resource.data.from == request.auth.uid
        && request.auth.uid in chatMembers(request.resource.data.chat);
      allow read: if isAdmin() || (ok() && request.auth.uid in chatMembers(resource.data.chat));
      allow delete: if isAdmin();
    }

    // صورة البروفيل مع الخصوصية: public | private (أنا فقط) | custom (قائمة allow)
    match /photos/{id} {
      allow read: if isAdmin() || (ok() && (request.auth.uid == id
        || resource.data.vis == 'public'
        || (resource.data.vis == 'custom' && request.auth.uid in resource.data.allow)));
      allow write: if ok() && request.auth.uid == id;
    }

    // الحالات (قصص) بحد أقصى أسبوع (مع سماح 5 دقائق لفرق الساعة)
    // القنوات: الكل يقرأ ويتابع، وصاحب القناة فقط ينشر
    // بلاغات المستخدمين: أي مستخدم يرسل، والمشرف فقط يقرأ
    // رموز الإشعارات (FCM): كل مستخدم يكتب رمزه فقط، والقراءة للخادم (Cloud Functions) فقط
    match /tokens/{id} {
      allow create, update, delete: if ok() && request.auth.uid == id;
      allow read: if false;
    }

    match /reports/{id} {
      allow create: if ok() && request.resource.data.by == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    match /channels/{id} {
      allow read: if ok();
      allow create: if ok() && request.resource.data.owner == request.auth.uid;
      allow update: if isAdmin() || (ok() && resource.data.owner == request.auth.uid)
        || (ok() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']));
      allow delete: if isAdmin() || (ok() && resource.data.owner == request.auth.uid);
    }

    match /stories/{id} {
      allow read: if ok();
      allow create, update: if ok() && request.auth.uid == id
        && request.resource.data.exp > request.time
        && request.resource.data.exp <= request.time + duration.value(605100, 's');
      allow delete: if isAdmin() || (ok() && request.auth.uid == id);
    }

    // مشاهدو الحالة: كل مشاهد يسجّل نفسه، وصاحب الحالة فقط يقرأ القائمة
    match /stories/{id}/views/{v} {
      allow create, update: if ok() && request.auth.uid == v;
      allow read: if isAdmin() || (ok() && (request.auth.uid == id || request.auth.uid == v));
      allow delete: if isAdmin() || (ok() && request.auth.uid == id);
    }

    // مكالمات WebRTC (إشارات فقط)
    match /calls/{cid} {
      allow create: if ok() && request.resource.data.from == request.auth.uid;
      allow read, update: if ok() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow delete: if isAdmin();
      match /{sub}/{x} {
        allow read, write: if ok() && (request.auth.uid == get(/databases/$(database)/documents/calls/$(cid)).data.from
                                    || request.auth.uid == get(/databases/$(database)/documents/calls/$(cid)).data.to);
      }
    }
  }
}

